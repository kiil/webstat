# Settings for webstat that are safe to keep in git. The collector key is a
# secret: it lives in the store (webstat.settings), set with
# POST /admin/settings, never in this repo.
{
  # Local hour (Copenhagen) for the morning report on yesterday.
  report_hour: 7
  # The sites that may send views, by the name used in the topic
  # (`webstat.<site>.*`). The first is the dashboard's default.
  #   origins  the pages' origins; a beacon from anywhere else gets 403
  #   base     where a path on the site is linked to
  #   name     how the site is named on the board and in notifications
  #   spike    a path whose hot score reaches this is "taking off" (one
  #            alert a day per path)
  #   clicks   what the beacon's click events count on this site
  #   prints   (optional) the name for clicks on /print/ links, counted
  #            apart from the other clicks
  sites: {
    folkets: {
      origins: ["https://www.folkets.dk" "https://folkets.dk"]
      base: "https://www.folkets.dk"
      name: "Folkets"
      spike: 6
      clicks: "Støtteklik"
    }
    klimaleksikon: {
      origins: ["https://klimaleksikon.dk" "https://www.klimaleksikon.dk"]
      base: "https://klimaleksikon.dk"
      name: "Klimaleksikon"
      spike: 4
      clicks: "Downloads"
      prints: "Udskriv som PDF"
    }
    climate: {
      origins: ["https://www.climate-encyclopedia.com" "https://climate-encyclopedia.com"]
      base: "https://www.climate-encyclopedia.com"
      name: "Climate Encyclopedia"
      spike: 4
      clicks: "Downloads"
      prints: "Udskriv som PDF"
    }
    docujai: {
      origins: ["https://docujai.com" "https://www.docujai.com"]
      base: "https://docujai.com"
      name: "docujAI"
      spike: 3
      clicks: "Kontaktklik"
    }
    kiils: {
      origins: ["https://www.kiils.dk" "https://kiils.dk"]
      base: "https://www.kiils.dk"
      name: "Kiils"
      spike: 3
      clicks: "Kontaktklik"
    }
  }
}
